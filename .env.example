SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# Auth — generate a long random string for JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-to-a-secret-admin-password

# Admin panel — set to the username that should have admin access (leave blank to disable)
ADMIN_USERNAME=

# Set to true when running behind an HTTPS reverse proxy (e.g. Caddy in production)
SECURE_COOKIES=false
